// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//
// bridge/counsel.bv — Counsel verification machinery (Briev-authored core).
//
// Phase 0 (scaffold spike): predictable, ABI-clean exports that prove the
// full build path (brievc build --library → bindings → Rust) and establish
// that Briev's own contract prover agrees on our code.
//
// Phase 1+ grows this into the obligation evaluator, bound/environment
// handling, failure reporter, and cross-verification sampler.

import "glue/c.bv";

// add — clean C ABI plumbing-validation export.
// Guarantees: returns the sum of its two Int arguments.
export defn add(a: Int, b: Int) -> Int {
    term a + b;
};

// within — runtime check-predicate helper (seed of the obligation evaluator).
// Returns 1 when `x` lies in the inclusive range [lo, hi]; else 0. Guard-first
// so only the true bound path evaluates the range check.
export defn within(x: Int, lo: Int, hi: Int) -> Int {
    when x >= lo && x <= hi {
        term 1;
    };
    term 0;
};

// step_up — one txn carrying a real, provable contract.
// Pre: `i` is below `cap`; post/goal: `i` has advanced to `cap`. The compiler
// proves the contract; a trivial `[true][true]` would be a compile error, so
// this also dogfoods Briev's own verification on our machinery.
txn step_up(i: Int, cap: Int) [i < cap][i == cap] -> Int {
    term i + 1;
};

// run_checked — Briev-authored obligation orchestrator (Ambition A1).
//
// NOTE 2026-11-11: the cross-ABI function-pointer callback path this used to
// take is NOT runtime-safe in Briev today. The C-binding generator emits a flat
// `int64_t (*pre)(int64_t)` signature, but the LLVM backend lowers the fn-ptr
// parameter to a closure/self convention (load the call target *from* the param
// slot, then call `(slot, arg)`). A flat `extern "C" fn` from a Rust host
// SIGSEGVs against it. Reverted; the reliable path is Briev-authored *check
// predicates* over a pure Int ABI (below), composed by the Rust facade.
// See BUGS.md for the full diagnostic + the Briev backend fix to re-enable.

// The following check predicates are pure, contract-carrying Briev exports.
// The Rust facade composes them (pre -> body -> post), driving each check with
// pure Int ABI so no function-pointer crosses the boundary.

// is_positive — 1 iff `x` is strictly greater than zero.
// Guarantees: returns 1 exactly when x > 0.
export defn is_positive(x: Int) -> Int {
    when x > 0 {
        term 1;
    };
    term 0;
};

// is_nonneg — 1 iff `x` is greater than or equal to zero.
// Guarantees: returns 1 exactly when x >= 0.
export defn is_nonneg(x: Int) -> Int {
    when x >= 0 {
        term 1;
    };
    term 0;
};

// eq — pure Int ABI output-equivalence primitive for the Phase-2 sampler.
// Returns 1 iff `a == b`. Used by the Rust sampler to compare each pair of
// original-vs-shadow outputs through Briev-computed equality.
// Guarantees: returns 1 exactly when a == b.
export defn eq(a: Int, b: Int) -> Int {
    when a == b {
        term 1;
    };
    term 0;
};